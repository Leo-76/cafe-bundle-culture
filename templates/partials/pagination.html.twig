{# partials/pagination.html.twig #}
{% if total > 1 %}
<nav class="pagination" aria-label="Pagination">
    {% if current > 1 %}
    <a class="pagination__btn pagination__btn--prev" href="{{ path(app.request.get('_route'), app.request.query.all|merge({page: current - 1})) }}" rel="prev" aria-label="Page précédente">
        <i class="fas fa-chevron-left"></i> Précédent
    </a>
    {% endif %}

    <div class="pagination__pages">
        {% for p in max(1, current - 2)..min(total, current + 2) %}
        {% if p == current %}
        <span class="pagination__page pagination__page--active" aria-current="page">{{ p }}</span>
        {% else %}
        <a class="pagination__page" href="{{ path(app.request.get('_route'), app.request.query.all|merge({page: p})) }}">{{ p }}</a>
        {% endif %}
        {% endfor %}
    </div>

    {% if current < total %}
    <a class="pagination__btn pagination__btn--next" href="{{ path(app.request.get('_route'), app.request.query.all|merge({page: current + 1})) }}" rel="next" aria-label="Page suivante">
        Suivant <i class="fas fa-chevron-right"></i>
    </a>
    {% endif %}
</nav>
{% endif %}
